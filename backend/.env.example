# Backend environment configuration for local development.
# Copy this file to `.env` and fill in real values. Never commit a real `.env`.
# Database defaults to SQLite for the local demo. Use PostgreSQL+PostGIS in production.

# Database: leave empty to use SQLite default (backend/krishikavach.db)
DATABASE_URL=
DATABASE_URL_SYNC=

# Auth
SECRET_KEY=krishikavach-dev-secret-change-me

# ML / prediction
PREDICTION_MODE=demo

# Voice
SPEECH_ENABLED=true

# Voice provider: "omniroute" (primary) or "browser" (fallback only)
VOICE_PROVIDER=omniroute
DEFAULT_VOICE_LANGUAGE=hi-IN

# OmniRoute-compatible endpoint configuration.
# Set OMNIROUTE_API_KEY to your real key in `.env`. NEVER commit the real key.
OMNIROUTE_BASE_URL=https://api.omniroute.online/v1
OMNIROUTE_API_KEY=
OMNIROUTE_STT_MODEL=whisper-1
OMNIROUTE_TTS_MODEL=tts-1
OMNIROUTE_TTS_VOICE=alloy
OMNIROUTE_TIMEOUT_SECONDS=20

# Demo time simulation (SIH only)
DEMO_TIME_ENABLED=true

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
